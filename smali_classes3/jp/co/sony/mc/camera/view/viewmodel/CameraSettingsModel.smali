3R\u001c\u0010\u0004\u001a\u0010\u0012\u000c\u0012\n \u0007*\u0004\u0018\u00010\u00060\u00060\u0005X\u0082\u0004\u00a2\u0006\u0002\n\u0000R\u001f\u0010\u0008\u001a\u0010\u0012\u000c\u0012\n \u0007*\u0004\u0018\u00010\u00060\u00060\t\u00a2\u0006\u0008\n\u0000\u001a\u0004\u0008\u0008\u0010\nR\u0014\u0010\u000b\u001a\u0008\u0012\u0004\u0012\u00020\u000c0\u0005X\u0082\u0004\u00a2\u0006\u0002\n\u0000R\u0017\u0010\r\u001a\u0008\u0012\u0004\u0012\u00020\u000c0\t\u00a2\u0006\u0008\n\u0000\u001a\u0004\u0008\u000e\u0010\nR\u000e\u0010\u000f\u001a\u00020\u0010X\u0082\u0004\u00a2\u0006\u0002\n\u0000R\u001c\u0010\u0011\u001a\u0010\u0012\u000c\u0012\n \u0007*\u0004\u0018\u00010\u00120\u00120\u0005X\u0082\u0004\u00a2\u0006\u0002\n\u0000R\u001f\u0010\u0013\u001a\u0010\u0012\u000c\u0012\n \u0007*\u0004\u0018\u00010\u00120\u00120\t\u00a2\u0006\u0008\n\u0000\u001a\u0004\u0008\u0014\u0010\nR\u001c\u0010\u0015\u001a\u0010\u0012\u000c\u0012\n \u0007*\u0004\u0018\u00010\u00160\u00160\u0005X\u0082\u0004\u00a2\u0006\u0002\n\u0000R\u001f\u0010\u0017\u001a\u0010\u0012\u000c\u0012\n \u0007*\u0004\u0018\u00010\u00160\u00160\t\u00a2\u0006\u0008\n\u0000\u001a\u0004\u0008\u0018\u0010\nRD\u0010\u0019\u001a8\u00124\u00122\u0012\u0004\u0012\u00020\u0012\u0012\u000c\u0012\n \u0007*\u0004\u0018\u00010\u001b0\u001b \u0007*\u0018\u0012\u0004\u0012\u00020\u0012\u0012\u000c\u0012\n \u0007*\u0004\u0018\u00010\u001b0\u001b\u0018\u00010\u001a0\u001a0\u0005X\u0082\u0004\u00a2\u0006\u0002\n\u0000RG\u0010\u001c\u001a8\u00124\u00122\u0012\u0004\u0012\u00020\u0012\u0012\u000c\u0012\n \u0007*\u0004\u0018\u00010\u001b0\u001b \u0007*\u0018\u0012\u0004\u0012\u00020\u0012\u0012\u000c\u0012\n \u0007*\u0004\u0018\u00010\u001b0\u001b\u0018\u00010\u001a0\u001a0\t\u00a2\u0006\u0008\n\u0000\u001a\u0004\u0008\u001d\u0010\nR\u001c\u0010\u001e\u001a\u0010\u0012\u000c\u0012\n \u0007*\u0004\u0018\u00010\u001b0\u001b0\u0005X\u0082\u0004\u00a2\u0006\u0002\n\u0000R\u001f\u0010\u001f\u001a\u0010\u0012\u000c\u0012\n \u0007*\u0004\u0018\u00010\u001b0\u001b0\t\u00a2\u0006\u0008\n\u0000\u001a\u0004\u0008 \u0010\nR\u001c\u0010!\u001a\u0010\u0012\u000c\u0012\n \u0007*\u0004\u0018\u00010\u001b0\u001b0\u0005X\u0082\u0004\u00a2\u0006\u0002\n\u0000R\u001f\u0010\"\u001a\u0010\u0012\u000c\u0012\n \u0007*\u0004\u0018\u00010\u001b0\u001b0\t\u00a2\u0006\u0008\n\u0000\u001a\u0004\u0008#\u0010\nR\u001c\u0010$\u001a\u0010\u0012\u000c\u0012\n \u0007*\u0004\u0018\u00010%0%0\u0005X\u0082\u0004\u00a2\u0006\u0002\n\u0000R\u001f\u0010&\u001a\u0010\u0012\u000c\u0012\n \u0007*\u0004\u0018\u00010%0%0\t\u00a2\u0006\u0008\n\u0000\u001a\u0004\u0008\'\u0010\nR\u001c\u0010(\u001a\u0010\u0012\u000c\u0012\n \u0007*\u0004\u0018\u00010)0)0\u0005X\u0082\u0004\u00a2\u0006\u0002\n\u0000R\u001f\u0010*\u001a\u0010\u0012\u000c\u0012\n \u0007*\u0004\u0018\u00010)0)0\t\u00a2\u0006\u0008\n\u0000\u001a\u0004\u0008+\u0010\nR\u001c\u0010,\u001a\u0010\u0012\u000c\u0012\n \u0007*\u0004\u0018\u00010-0-0\u0005X\u0082\u0004\u00a2\u0006\u0002\n\u0000R\u001f\u0010.\u001a\u0010\u0012\u000c\u0012\n \u0007*\u0004\u0018\u00010-0-0\t\u00a2\u0006\u0008\n\u0000\u001a\u0004\u0008/\u0010\nR\u0017\u00100\u001a\u0008\u0012\u0004\u0012\u00020201\u00a2\u0006\u0008\n\u0000\u001a\u0004\u00083\u00104R\u001c\u00105\u001a\u0010\u0012\u000c\u0012\n \u0007*\u0004\u0018\u000106060\u0005X\u0082\u0004\u00a2\u0006\u0002\n\u0000R\u001f\u00107\u001a\u0010\u0012\u000c\u0012\n \u0007*\u0004\u0018\u000106060\t\u00a2\u0006\u0008\n\u0000\u001a\u0004\u00088\u0010\nR\u0017\u00109\u001a\u0008\u0012\u0004\u0012\u00020201\u00a2\u0006\u0008\n\u0000\u001a\u0004\u0008:\u00104R\u001c\u0010;\u001a\u0010\u0012\u000c\u0012\n \u0007*\u0004\u0018\u00010<0<0\u0005X\u0082\u0004\u00a2\u0006\u0002\n\u0000R\u001f\u0010=\u001a\u0010\u0012\u000c\u0012\n \u0007*\u0004\u0018\u00010<0<0\t\u00a2\u0006\u0008\n\u0000\u001a\u0004\u0008>\u0010\nR\u0017\u0010?\u001a\u0008\u0012\u0004\u0012\u00020@0\t\u00a2\u0006\u0008\n\u0000\u001a\u0004\u0008A\u0010\nR\u001c\u0010B\u001a\u0010\u0012\u000c\u0012\n \u0007*\u0004\u0018\u00010C0C0\u0005X\u0082\u0004\u00a2\u0006\u0002\n\u0000R\u001f\u0010D\u001a\u0010\u0012\u000c\u0012\n \u0007*\u0004\u0018\u00010C0C0\t\u00a2\u0006\u0008\n\u0000\u001a\u0004\u0008E\u0010\nR\u001c\u0010F\u001a\u0010\u0012\u000c\u0012\n \u0007*\u0004\u0018\u00010G0G0\u0005X\u0082\u0004\u00a2\u0006\u0002\n\u0000R\u001f\u0010H\u001a\u0010\u0012\u000c\u0012\n \u0007*\u0004\u0018\u00010G0G0\t\u00a2\u0006\u0008\n\u0000\u001a\u0004\u0008I\u0010\nR\u0017\u0010J\u001a\u0008\u0012\u0004\u0012\u00020201\u00a2\u0006\u0008\n\u0000\u001a\u0004\u0008K\u00104R\u001c\u0010L\u001a\u0010\u0012\u000c\u0012\n \u0007*\u0004\u0018\u00010M0M0\u0005X\u0082\u0004\u00a2\u0006\u0002\n\u0000R\u001f\u0010N\u001a\u0010\u0012\u000c\u0012\n \u0007*\u0004\u0018\u00010M0M0\t\u00a2\u0006\u0008\n\u0000\u001a\u0004\u0008O\u0010\nR\u001c\u0010P\u001a\u0010\u0012\u000c\u0012\n \u0007*\u0004\u0018\u00010Q0Q0\u0005X\u0082\u0004\u00a2\u0006\u0002\n\u0000R\u001f\u0010R\u001a\u0010\u0012\u000c\u0012\n \u0007*\u0004\u0018\u00010Q0Q0\t\u00a2\u0006\u0008\n\u0000\u001a\u0004\u0008S\u0010\nR\u001c\u0010T\u001a\u0010\u0012\u000c\u0012\n \u0007*\u0004\u0018\u00010U0U0\u0005X\u0082\u0004\u00a2\u0006\u0002\n\u0000R\u001f\u0010V\u001a\u0010\u0012\u000c\u0012\n \u0007*\u0004\u0018\u00010U0U0\t\u00a2\u0006\u0008\n\u0000\u001a\u0004\u0008W\u0010\nR\u001c\u0010X\u001a\u0010\u0012\u000c\u0012\n \u0007*\u0004\u0018\u00010Y0Y0\u0005X\u0082\u0004\u00a2\u0006\u0002\n\u0000R\u001f\u0010Z\u001a\u0010\u0012\u000c\u0012\n \u0007*\u0004\u0018\u00010Y0Y0\t\u00a2\u0006\u0008\n\u0000\u001a\u0004\u0008[\u0010\nR\u001c\u0010\\\u001a\u0010\u0012\u000c\u0012\n \u0007*\u0004\u0018\u00010]0]0\u0005X\u0082\u0004\u00a2\u0006\u0002\n\u0000R\u001f\u0010^\u001a\u0010\u0012\u000c\u0012\n \u0007*\u0004\u0018\u00010]0]0\t\u00a2\u0006\u0008\n\u0000\u001a\u0004\u0008_\u0010\nR\u001c\u0010`\u001a\u0010\u0012\u000c\u0012\n \u0007*\u0004\u0018\u00010a0a0\u0005X\u0082\u0004\u00a2\u0006\u0002\n\u0000R\u001f\u0010b\u001a\u0010\u0012\u000c\u0012\n \u0007*\u0004\u0018\u00010a0a0\t\u00a2\u0006\u0008\n\u0000\u001a\u0004\u0008c\u0010\nR\u0017\u0010d\u001a\u0008\u0012\u0004\u0012\u00020201\u00a2\u0006\u0008\n\u0000\u001a\u0004\u0008e\u00104R\u001c\u0010f\u001a\u0010\u0012\u000c\u0012\n \u0007*\u0004\u0018\u00010g0g0\u0005X\u0082\u0004\u00a2\u0006\u0002\n\u0000R\u001f\u0010h\u001a\u0010\u0012\u000c\u0012\n \u0007*\u0004\u0018\u00010g0g0\t\u00a2\u0006\u0008\n\u0000\u001a\u0004\u0008i\u0010\nR\u0017\u0010j\u001a\u0008\u0012\u0004\u0012\u00020201\u00a2\u0006\u0008\n\u0000\u001a\u0004\u0008k\u00104R\u001c\u0010l\u001a\u0010\u0012\u000c\u0012\n \u0007*\u0004\u0018\u00010m0m0\u0005X\u0082\u0004\u00a2\u0006\u0002\n\u0000R\u001f\u0010n\u001a\u0010\u0012\u000c\u0012\n \u0007*\u0004\u0018\u00010m0m0\t\u00a2\u0006\u0008\n\u0000\u001a\u0004\u0008o\u0010\nR\u0017\u0010p\u001a\u0008\u0012\u0004\u0012\u00020201\u00a2\u0006\u0008\n\u0000\u001a\u0004\u0008q\u00104R\u001c\u0010r\u001a\u0010\u0012\u000c\u0012\n \u0007*\u0004\u0018\u00010s0s0\u0005X\u0082\u0004\u00a2\u0006\u0002\n\u0000R\u001f\u0010t\u001a\u0010\u0012\u000c\u0012\n \u0007*\u0004\u0018\u00010s0s0\t\u00a2\u0006\u0008\n\u0000\u001a\u0004\u0008u\u0010\nR\u001c\u0010v\u001a\u0010\u0012\u000c\u0012\n \u0007*\u0004\u0018\u00010w0w0\u0005X\u0082\u0004\u00a2\u0006\u0002\n\u0000R\u001f\u0010x\u001a\u0010\u0012\u000c\u0012\n \u0007*\u0004\u0018\u00010w0w0\t\u00a2\u0006\u0008\n\u0000\u001a\u0004\u0008y\u0010\nR\u001c\u0010z\u001a\u0010\u0012\u000c\u0012\n \u0007*\u0004\u0018\u00010{0{0\u0005X\u0082\u0004\u00a2\u0006\u0002\n\u0000R\u001f\u0010|\u001a\u0010\u0012\u000c\u0012\n \u0007*\u0004\u0018\u00010{0{0\t\u00a2\u0006\u0008\n\u0000\u001a\u0004\u0008}\u0010\nR\u001c\u0010~\u001a\u0010\u0012\u000c\u0012\n \u0007*\u0004\u0018\u00010\u007f0\u007f0\u0005X\u0082\u0004\u00a2\u0006\u0002\n\u0000R!\u0010\u0080\u0001\u001a\u0010\u0012\u000c\u0012\n \u0007*\u0004\u0018\u00010\u007f0\u007f0\t\u00a2\u0006\t\n\u0000\u001a\u0005\u0008\u0081\u0001\u0010\nR\u0019\u0010\u0082\u0001\u001a\u0008\u0012\u0004\u0012\u00020201\u00a2\u0006\t\n\u0000\u001a\u0005\u0008\u0083\u0001\u00104R\u001d\u0010\u0084\u0001\u001a\u0010\u0012\u000c\u0012\n \u0007*\u0004\u0018\u00010Q0Q0\u0005X\u0082\u0004\u00a2\u0006\u0002\n\u0000R!\u0010\u0085\u0001\u001a\u0010\u0012\u000c\u0012\n \u0007*\u0004\u0018\u00010Q0Q0\t\u00a2\u0006\t\n\u0000\u001a\u0005\u0008\u0086\u0001\u0010\nR\u001d\u0010\u0087\u0001\u001a\u0010\u0012\u000c\u0012\n \u0007*\u0004\u0018\u00010\u001b0\u001b0\u0005X\u0082\u0004\u00a2\u0006\u0002\n\u0000R!\u0010\u0088\u0001\u001a\u0010\u0012\u000c\u0012\n \u0007*\u0004\u0018\u00010\u001b0\u001b0\t\u00a2\u0006\t\n\u0000\u001a\u0005\u0008\u0089\u0001\u0010\nR\u001f\u0010\u008a\u0001\u001a\u0012\u0012\u000e\u0012\u000c \u0007*\u0005\u0018\u00010\u008b\u00010\u008b\u00010\u0005X\u0082\u0004\u00a2\u0006\u0002\n\u0000R#\u0010\u008c\u0001\u001a\u0012\u0012\u000e\u0012\u000c \u0007*\u0005\u0018\u00010\u008b\u00010\u008b\u00010\t\u00a2\u0006\t\n\u0000\u001a\u0005\u0008\u008d\u0001\u0010\nR\u001f\u0010\u008e\u0001\u001a\u0012\u0012\u000e\u0012\u000c \u0007*\u0005\u0018\u00010\u008f\u00010\u008f\u00010\u0005X\u0082\u0004\u00a2\u0006\u0002\n\u0000R#\u0010\u0090\u0001\u001a\u0012\u0012\u000e\u0012\u000c \u0007*\u0005\u0018\u00010\u008f\u00010\u008f\u00010\t\u00a2\u0006\t\n\u0000\u001a\u0005\u0008\u0091\u0001\u0010\nR\u001f\u0010\u0092\u0001\u001a\u0012\u0012\u000e\u0012\u000c \u0007*\u0005\u0018\u00010\u0093\u00010\u0093\u00010\u0005X\u0082\u0004\u00a2\u0006\u0002\n\u0000R#\u0010\u0094\u0001\u001a\u0012\u0012\u000e\u0012\u000c \u0007*\u0005\u0018\u00010\u0093\u00010\u0093\u00010\t\u00a2\u0006\t\n\u0000\u001a\u0005\u0008\u0095\u0001\u0010\nR\u001f\u0010\u0096\u0001\u001a\u0012\u0012\u000e\u0012\u000c \u0007*\u0005\u0018\u00010\u0097\u00010\u0097\u00010\u0005X\u0082\u0004\u00a2\u0006\u0002\n\u0000R#\u0010\u0098\u0001\u001a\u0012\u0012\u000e\u0012\u000c \u0007*\u0005\u0018\u00010\u0097\u00010\u0097\u00010\t\u00a2\u0006\t\n\u0000\u001a\u0005\u0008\u0099\u0001\u0010\nR\u0019\u0010\u009a\u00