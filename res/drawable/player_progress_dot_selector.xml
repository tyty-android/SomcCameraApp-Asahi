<?xml version="1.0" encoding="utf-8"?>
<selector
  xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <shape android:shape="oval">
            <size android:height="@dimen/player_seekbar_progress_dot_height" android:width="@dimen/player_seekbar_progress_dot_height" />
            <solid android:color="@android:color/white" />
        </shape>
    </item>
    <item android:state_focused="true">
        <shape android:shape="oval">
            <size android:height="@dimen/player_seekbar_progress_dot_height" android:width="@dimen/player_seekbar_progress_dot_height" />
            <solid android:color="@color/player_seekbar_progress_dot_focused_color" />
            <stroke android:width="@dimen/player_seekbar_progress_dot_stroke_width" android:color="@android:color/transparent" />
        </shape>
    </item>
    <item>
        <shape android:shape="oval">
            <size android:height="@dimen/player_seekbar_progress_dot_height" android:width="@dimen/player_seekbar_progress_dot_height" />
            <solid android:color="@android:color/white" />
            <stroke android:width="@dimen/player_seekbar_progress_dot_stroke_width" android:color="@android:color/transparent" />
        </shape>
    </item>
</selector>
