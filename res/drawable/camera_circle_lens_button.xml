<?xml version="1.0" encoding="utf-8"?>
<selector
  xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_activated="true">
        <layer-list>
            <item android:left="@dimen/auto_mode_selected_zoom_circle_margin" android:top="@dimen/auto_mode_selected_zoom_circle_margin" android:right="@dimen/auto_mode_selected_zoom_circle_margin" android:bottom="@dimen/auto_mode_selected_zoom_circle_margin">
                <inset android:drawable="@drawable/camera_circle_lens_button_bg" />
            </item>
            <item>
                <ripple android:color="#80ffffff">
                    <item android:id="@android:id/mask">
                        <shape android:shape="oval">
                            <solid android:color="@android:color/white" />
                        </shape>
                    </item>
                </ripple>
            </item>
        </layer-list>
    </item>
    <item android:state_activated="false">
        <layer-list>
            <item android:left="@dimen/auto_mode_zoom_circle_margin" android:top="@dimen/auto_mode_zoom_circle_margin" android:right="@dimen/auto_mode_zoom_circle_margin" android:bottom="@dimen/auto_mode_zoom_circle_margin">
                <inset android:drawable="@drawable/camera_circle_lens_button_bg" />
            </item>
            <item>
                <ripple android:color="#80ffffff">
                    <item android:id="@android:id/mask" android:top="@dimen/auto_mode_zoom_circle_margin" android:bottom="@dimen/auto_mode_zoom_circle_margin" android:start="@dimen/auto_mode_zoom_circle_margin" android:end="@dimen/auto_mode_zoom_circle_margin">
                        <shape android:shape="oval">
                            <solid android:color="@android:color/white" />
                        </shape>
                    </item>
                </ripple>
            </item>
        </layer-list>
    </item>
</selector>
