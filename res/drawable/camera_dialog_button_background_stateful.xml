<?xml version="1.0" encoding="utf-8"?>
<selector
  xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <corners android:radius="@dimen/dialog_youtube_login_button_outline_radius" />
            <stroke android:width="@dimen/camera_outline_size" android:color="@color/camera_gray03_color" />
            <solid android:color="@color/camera_dialog_button_pressed_color" />
        </shape>
    </item>
    <item android:state_pressed="false">
        <shape android:shape="rectangle">
            <corners android:radius="@dimen/dialog_youtube_login_button_outline_radius" />
            <stroke android:width="@dimen/camera_outline_size" android:color="@color/camera_gray03_color" />
            <solid android:color="@color/camera_gray01_color" />
        </shape>
    </item>
</selector>
