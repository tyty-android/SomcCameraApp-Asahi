<?xml version="1.0" encoding="UTF-8"?>
<tt xml:lang="en"
    xmlns="http://www.w3.org/ns/ttml"
    xmlns:tts="http://www.w3.org/ns/ttml#styling"
    xmlns:ttm="http://www.w3.org/ns/ttml#metadata">
  <head>
    <styling>
      <style tts:backgroundColor="transparent" tts:color="white" tts:fontFamily="monospace" tts:fontSize="75%" xml:id="basic"/>
    </styling>
    <layout>
      <region tts:backgroundColor="transparent" tts:showBackground="whenActive" tts:displayAlign="after" tts:textAlign="center" xml:id="pop1"/>
    </layout>
  </head>
  <body region='pop1' style='basic'>
    <div>
      